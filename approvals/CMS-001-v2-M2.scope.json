  "scope": [
    "Full-site typed content/editors with current baseline controlled templates",
    "Explicit OWNER import into home-v2, current M1 Hero/SEO preservation and pinned provenance mapping",
    "Record add/edit/visibility archive/reorder within caps; manual CAS Save/idempotency",
    "Version-compatible immutable snapshot/review and protected exact-value source checks",
    "Authenticated full-site draft/snapshot preview plus APPROVED unpublished static QA export",
    "Relevant M1+M2 tests, High checkpoints and local evidence/runbook/handoff"
  ],
  "excluded_actions": [
    "M3 upload/Storage/quarantine/private new media/source uploads",
    "M4 publication/current pointer/releases/rollback/full backup-restore",
    "Cloud or production planning/deployment/live writes",
    "Real accounts/PII/Firebase login/ADC/Blaze/billing/IAM",
    "New variants/theme/page-builder/artwork generation",
    "Backend lead/email/analytics/AI/payment/blog/portal/multilingual routes",
    "Membership administration/self-review override/role-combination/autosave",
    "Dependency upgrades/new packages/global tooling/plugin/Codex/sandbox/approval policy changes",
    "Reset/reseed/delete M1/M2 drafts or immutable history"
  ],
